{
  "name": "reachinbox-email-scheduler",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@reachinbox/api",
    "dev:worker": "npm run worker --workspace=@reachinbox/api",
    "dev:web": "npm run dev --workspace=@reachinbox/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
